<% if notice %>
  <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
    <%= notice %>
  </div>
<% end %>

<% content_for :title, @tag.name %>

<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= @tag.name %></h1>

  <div class="space-y-4">
    <div>
      <span class="font-semibold text-gray-700">Usage:</span>
      <span class="text-gray-900"><%= @tag.tasks.count %> <%= 'task'.pluralize(@tag.tasks.count) %></span>
    </div>

    <% if @tag.tasks.any? %>
      <div>
        <span class="font-semibold text-gray-700 mb-2 block">Tasks with this tag:</span>
        <ul class="list-disc list-inside text-gray-900">
          <% @tag.tasks.limit(10).each do |task| %>
            <li>
              <%= link_to task.title, organization_project_task_path(task.project.organization, task.project, task), class: "text-blue-600 hover:underline" %>
            </li>
          <% end %>
          <% if @tag.tasks.count > 10 %>
            <li class="text-gray-500 italic">... and <%= @tag.tasks.count - 10 %> more</li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>

<div class="flex gap-4">
  <%= link_to "Edit this tag", edit_tag_path(@tag), class: "inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
  <%= link_to "Back to tags", tags_path, class: "inline-block px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 transition" %>
  <%= button_to "Destroy this tag", tag_path(@tag), method: :delete, data: { confirm: "Are you sure?" }, class: "inline-block px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition" %>
</div>