<% content_for :title, "Edit tag" %>

<h1 class="text-2xl font-bold mb-6 text-gray-800">Edit tag</h1>

<div class="bg-white shadow rounded-lg p-6 mb-6">
  <%= render "form", tag: @tag %>
</div>

<div>
  <%= link_to "Show this tag", tag_path(@tag), class: "inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
  <%= link_to "Back to tags", tags_path, class: "inline-block px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 transition" %>
</div>