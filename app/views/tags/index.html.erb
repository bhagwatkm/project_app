<% if notice %>
  <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-200">
    <%= notice %>
  </div>
<% end %>

<% content_for :title, "Tags" %>

<h1 class="text-3xl font-bold mb-6 text-gray-800">Tags</h1>

<div class="mb-4">
  <%= link_to "New tag", new_tag_path, class: "inline-block px-6 py-3 bg-green-600 text-white font-semibold rounded shadow hover:bg-green-700 transition" %>
</div>

<div id="tags" class="mb-6">
  <% if @tags.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full bg-white shadow rounded-lg">
        <thead>
          <tr>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Usage</th>
            <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @tags.each do |tag| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 border-b border-gray-200">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                  <%= tag.name %>
                </span>
              </td>
              <td class="px-6 py-4 border-b border-gray-200">
                <%= tag.tasks.count %> <%= 'task'.pluralize(tag.tasks.count) %>
              </td>
              <td class="px-6 py-4 border-b border-gray-200">
                <div class="flex gap-2">
                  <%= link_to "Edit", edit_tag_path(tag), class: "px-3 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-xs" %>
                  <%= button_to "Delete", tag_path(tag), method: :delete, data: { confirm: "Are you sure?" }, class: "px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-xs" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded">
      <p class="text-yellow-700">No tags found. Create your first tag!</p>
    </div>
  <% end %>
</div>

<div class="flex justify-center my-6">
  <%= will_paginate @tags, class: 'pagination flex space-x-2' %>
</div>